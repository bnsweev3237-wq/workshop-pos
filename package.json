{
  "name": "workshop-pos",
  "version": "0.1.0",
  "description": "Workshop pricing calculator & point of sale — standalone edition",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "preelectron": "node scripts/clean-native-build.js && electron-builder install-app-deps",
    "electron": "electron .",
    "predist": "node scripts/clean-native-build.js",
    "dist": "electron-builder",
    "predist:mac": "node scripts/clean-native-build.js",
    "dist:mac": "electron-builder --mac",
    "predist:win": "node scripts/clean-native-build.js",
    "dist:win": "electron-builder --win",
    "predist:linux": "node scripts/clean-native-build.js",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "better-sqlite3-session-store": "^0.1.0",
    "express": "^4.21.1",
    "express-session": "^1.18.1"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.workshoppos.app",
    "productName": "Workshop POS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "public/**/*",
      "package.json",
      "!**/*.db",
      "!**/*.secret"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  }
}
